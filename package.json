{
  "name": "nexus-finance",
  "private": true,
  "version": "1.0.0-beta.1",
  "description": "Личный учёт финансов: доходы, расходы, бюджеты, цели, инвестиции и регулярные платежи. Данные хранятся локально.",
  "type": "module",
  "author": {
    "name": "Павел К.",
    "email": "kpavels1997@gmail.com",
    "url": "https://t.me/dev_aitech"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-aitechpro/nexus-finance-beta"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --open --config vite.dev.config.ts",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:win": "node scripts/build-windows.mjs",
    "build:apk": "node scripts/build-android.mjs --release",
    "build:apk:debug": "node scripts/build-android.mjs --debug",
    "electron": "electron .",
    "electron:debug": "electron . --dev",
    "dev:desktop": "npm run build && npm run electron:debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "map": "node scripts/generate-project-map.mjs",
    "verify:dist": "node scripts/check-dist.mjs",
    "verify:file": "node scripts/check-file-protocol.mjs",
    "verify:db": "node scripts/check-desktop-db.mjs",
    "verify:docs": "node scripts/check-docs.mjs",
    "verify:updater": "node scripts/check-update-deps.mjs",
    "verify:bundles": "node scripts/check-bundles.mjs",
    "verify": "npm run test && npm run build && npm run verify:dist && npm run verify:file && npm run verify:docs && npm run verify:updater && npm run verify:bundles",
    "bench": "node scripts/bench-storage.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "clsx": "2.1.1",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql.js": "^1.13.0",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.nexus.finance",
    "productName": "NEXUS Finance",
    "directories": {
      "output": "dist-electron"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "!**/node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/semver/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/sax/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/debug/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/ms/**/*",
      "node_modules/universalify/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/lazy-val/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/docs/**"
    ],
    "extraMetadata": {
      "main": "electron-main.cjs"
    },
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS Finance",
      "uninstallDisplayName": "NEXUS Finance ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "dev-aitechpro",
      "repo": "nexus-finance-beta",
      "releaseType": "prerelease",
      "channel": "beta"
    }
  }
}
