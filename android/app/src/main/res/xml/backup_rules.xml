<?xml version="1.0" encoding="utf-8"?>
<!-- Тот же запрет для Android 11 и ниже, где dataExtractionRules ещё не
     читается и резервное копирование настраивается fullBackupContent. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
